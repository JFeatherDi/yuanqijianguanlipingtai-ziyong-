# 确保 shell 脚本在 checkout 时始终使用 LF 行尾
start.sh text eol=lf

# Windows 批处理保持 CRLF
start.bat text eol=crlf

# 源码文件统一按文本处理
*.py text
*.html text
*.css text
*.js text
*.json text
*.vue text
*.md text
*.txt text
requirements.txt text

# 配置文件入库存 LF：否则编辑器在 Windows 上写入的 CRLF 会被原样提交，
# 让 git diff --check 一直报 trailing whitespace
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制 / 生成文件不做转换
data.db binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary